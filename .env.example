# Copy to .env for local development only. Never commit the real .env file.
# OS environment variables take precedence over values in this file.
# A server-side fallback key requires firewall.yaml to bind 127.0.0.1 or [::1].
# Prefer this application-specific name; OPENAI_API_KEY is also accepted.
LLM_FW_OPENAI_API_KEY=
OPENAI_API_KEY=

# Required only when `proxy_auth.enabled: true` (typically for a public bind).
LLM_FW_PROXY_AUTH_TOKEN=

# Required only when `tenant_store.enabled: true`. This protects /admin/v1/*
# and must be different from every client token.
LLM_FW_ADMIN_TOKEN=

# Required to enable the OIDC browser-login flow when `tenant_store.enabled: true`.
# Generate 32 random bytes and encode them as unpadded base64url; store this only
# in .env for local development or a production secret manager.
LLM_FW_OIDC_STATE_KEY=

# Required only for durable signed policy webhooks. Generate 32 random bytes
# and encode as unpadded base64url; keep this in a secret manager in production.
LLM_FW_WEBHOOK_SIGNING_KEY=

# Required only when `tenant_store.backend: postgres`. Use a dedicated,
# least-privileged database role and `sslmode=require`; it may contain a
# password, so keep it only in .env or your production secret manager.
LLM_FW_POSTGRES_URL=

# Required only when `redis_limits.enabled: true`. It can contain credentials,
# so keep it only in .env or your production secret manager.
LLM_FW_REDIS_URL=
