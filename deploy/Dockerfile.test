# Local fixture baseline. Keep the production Gateway image separate.
# Multi-platform index digests cover linux/amd64 and linux/arm64.
FROM rust:1.98-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS build
ENV RUSTUP_TOOLCHAIN=1.98.0 \
    CARGO_TARGET_DIR=/opt/soup-wall/target \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    PYTHONDONTWRITEBYTECODE=1
# A dated, signed Debian archive also fixes the Python/native package inputs.
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261007T000000Z bookworm main\n' > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/soup-wall
COPY . .
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/opt/soup-wall/target,id=soup-wall-fixture-target-${TARGETARCH},sharing=locked \
    python3 scripts/test-environment.py --prepare-image

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261007T000000Z bookworm main\n' > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8
WORKDIR /opt/soup-wall
COPY --from=build /bundle/ /
USER 65532:65532
ENTRYPOINT ["python3", "/opt/soup-wall/scripts/test-environment.py", "--inside-container"]
