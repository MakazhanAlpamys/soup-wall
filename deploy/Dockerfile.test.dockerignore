# This Dockerfile-specific allowlist retains fixture sources omitted by the
# production .dockerignore. No Git metadata, home directories or model assets.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!LICENSE
!NOTICE
!crates/
!crates/*/
!crates/*/Cargo.toml
!crates/*/src/
!crates/*/src/**
!crates/*/examples/
!crates/*/examples/*.rs
!crates/agent/policies/
!crates/agent/policies/agent-default.yaml
!crates/agent/tests/
!crates/agent/tests/scenarios.rs
!crates/agentfw/tests/
!crates/agentfw/tests/mcp_admission.rs
!crates/agentfw/tests/native_endpoint.rs
!crates/agentfw/tests/judge_endpoint.rs
!vendor/
!vendor/kryptering/
!vendor/kryptering/**
!scripts/
!scripts/test-environment.py
!scripts/clean-setup-acceptance.py
!scripts/tests/
!scripts/tests/test_test_environment.py
!rule_baseline/
!rule_baseline/rule_baseline.py
!deploy/
!deploy/Dockerfile.test
!deploy/Dockerfile.test.dockerignore
**/.env
**/.env.*
**/*.pem
**/__pycache__
**/.git
